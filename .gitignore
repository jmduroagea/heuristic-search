@"
# Compiled solver
shortest_path/main_solver
shortest_path/main_solver.exe

# DIMACS road maps: too large for git (see README)
shortest_path/maps/*
!shortest_path/maps/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Editor and OS files
.vscode/
Thumbs.db
.DS_Store
"@ | Set-Content -Encoding ascii -Path .gitignore